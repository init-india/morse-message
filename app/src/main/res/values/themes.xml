<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws all UI; this framework theme only covers the window before Compose starts. -->
    <style name="Theme.MorseMessage" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Text-menu popup: shows only its dialog over the app the user came from -->
    <style name="Theme.MorseMessage.Translucent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
